#!/usr/bin/env python3

import argparse
import subprocess
import time
import os
import sys

OUT_DIR = "out"
INPUT_FILE = os.path.join(OUT_DIR, "input_two_tone.pcm")
OUTPUT_FILE = os.path.join(OUT_DIR, "outputFixed.pcm")
C_BINARY = "./fir_filter"


# =========================
# AUDIO UTILS
# =========================
def play_wav(path):
    try:
        subprocess.Popen(["aplay", path])
    except Exception as e:
        print(f"Error reproduciendo audio: {e}")


def pcm32_to_wav(pcm_path, wav_path, fs):
    import numpy as np
    import wave

    data = np.fromfile(pcm_path, dtype=np.int32)
    data = data.astype(np.float32) / (2**31 - 1)
    data_int16 = np.int16(data * 32767)

    with wave.open(wav_path, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(fs)
        wf.writeframes(data_int16.tobytes())


def wav_to_pcm32(wav_path, pcm_path):
    import wave
    import numpy as np

    with wave.open(wav_path, 'rb') as wf:
        n_channels = wf.getnchannels()
        sampwidth = wf.getsampwidth()
        n_frames = wf.getnframes()
        fs = wf.getframerate()
        raw = wf.readframes(n_frames)

    if sampwidth == 2:
        data = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
    elif sampwidth == 4:
        data = np.frombuffer(raw, dtype=np.int32).astype(np.float32) / (2**31)
    else:
        raise ValueError("Formato WAV no soportado")

    if n_channels > 1:
        data = data[::n_channels]

    max_val = max(abs(data)) if len(data) > 0 else 1
    if max_val > 0:
        data = data / max_val

    pcm32 = np.int32(data * (2**31 - 1))
    pcm32.tofile(pcm_path)

    return pcm_path, fs


# =========================
# C EXECUTION
# =========================
def run_c_filter(cmd):
    t0 = time.perf_counter()
    result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    t1 = time.perf_counter()
    return (t1 - t0) * 1000.0, result


# =========================
# GUI
# =========================
def run_gui():
    import tkinter as tk
    from tkinter import filedialog, messagebox
    import numpy as np
    from tkinterdnd2 import TkinterDnD, DND_FILES

    import matplotlib
    matplotlib.use("TkAgg")
    from matplotlib.figure import Figure
    from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
    from matplotlib.gridspec import GridSpec

    DEFAULT_FS = 48000
    current_fs = DEFAULT_FS

    input_wav_path = None
    coef_file_path = None
    input_pcm_path = INPUT_FILE

    os.makedirs(OUT_DIR, exist_ok=True)

    # ================= WAV =================
    def load_wav_file(path):
        nonlocal input_pcm_path, current_fs, input_wav_path

        pcm_path = os.path.join(OUT_DIR, "input_from_gui.pcm")

        try:
            pcm_path, fs = wav_to_pcm32(path, pcm_path)
            input_pcm_path = pcm_path
            current_fs = fs
            input_wav_path = path

            label_input.config(text=f"Input: {os.path.basename(path)} ({fs} Hz)")
            plot_input()

        except Exception as e:
            messagebox.showerror("Error", str(e))

    def open_wav():
        path = filedialog.askopenfilename(filetypes=[("WAV files", "*.wav")])
        if path:
            load_wav_file(path)

    def drop(event):
        load_wav_file(event.data.strip("{}"))

    # ================= MULTITONO =================
    def open_multitone_window():
        win = tk.Toplevel(root)
        win.title("Test Multitono")

        tk.Label(win, text="Frecuencia 1 (Hz)").grid(row=0, column=0)
        tk.Label(win, text="Frecuencia 2 (Hz)").grid(row=1, column=0)
        tk.Label(win, text="Amplitud 1").grid(row=2, column=0)
        tk.Label(win, text="Amplitud 2").grid(row=3, column=0)
        tk.Label(win, text="Frecuencia de muestreo").grid(row=4, column=0)

        entry_f1 = tk.Entry(win); entry_f1.insert(0, "1000")
        entry_f2 = tk.Entry(win); entry_f2.insert(0, "8000")
        entry_a1 = tk.Entry(win); entry_a1.insert(0, "0.45")
        entry_a2 = tk.Entry(win); entry_a2.insert(0, "0.45")
        entry_fs = tk.Entry(win); entry_fs.insert(0, "48000")

        entry_f1.grid(row=0, column=1)
        entry_f2.grid(row=1, column=1)
        entry_a1.grid(row=2, column=1)
        entry_a2.grid(row=3, column=1)
        entry_fs.grid(row=4, column=1)

        def generate():
            nonlocal input_pcm_path, current_fs, input_wav_path

            f1 = float(entry_f1.get())
            f2 = float(entry_f2.get())
            a1 = float(entry_a1.get())
            a2 = float(entry_a2.get())
            fs = int(entry_fs.get())

            t = np.arange(0, 2.0, 1/fs)
            signal = a1*np.sin(2*np.pi*f1*t) + a2*np.sin(2*np.pi*f2*t)

            pcm = np.int32(signal * (2**31 - 1))
            pcm.tofile(INPUT_FILE)

            input_pcm_path = INPUT_FILE
            current_fs = fs
            input_wav_path = None

            label_input.config(text=f"Input: Multitono ({fs} Hz)")
            plot_input()

            win.destroy()

        tk.Button(win, text="Generar señal multitono", command=generate).grid(row=5, columnspan=2)

    # ================= PLAYER =================
    def play_input_audio():
        if input_wav_path is not None:
            play_wav(input_wav_path)
            return

        temp_wav = os.path.join(OUT_DIR, "temp_input.wav")
        pcm32_to_wav(input_pcm_path, temp_wav, current_fs)
        play_wav(temp_wav)

    def play_output_audio():
        if not os.path.exists(OUTPUT_FILE):
            return

        temp_wav = os.path.join(OUT_DIR, "temp_output.wav")
        pcm32_to_wav(OUTPUT_FILE, temp_wav, current_fs)
        play_wav(temp_wav)

    # ================= POPUP =================
    def show_output_popup(t_ms, out, err):
        win = tk.Toplevel(root)
        win.title("Ejecución FIR")

        txt = tk.Text(win, wrap="word")
        txt.pack(fill="both", expand=True)

        txt.insert("end", f"Tiempo de ejecución: {t_ms:.3f} ms\n\n")

        if out:
            txt.insert("end", "STDOUT:\n" + out + "\n")

        if err:
            txt.insert("end", "\nSTDERR:\n" + err + "\n")

        txt.config(state="disabled")

    # ================= FILTER =================
    def run_filter():
        if coef_file_path is None:
            messagebox.showerror("Error", "Seleccione coeficientes")
            return

        nb_frac = int(entry_nb_frac.get())
        samples = int(entry_samples.get())

        cmd = [
            C_BINARY,
            f"-fc={coef_file_path}",
            f"-NB-FRAC={nb_frac}",
            f"--samples={samples}",
            input_pcm_path
        ]

        t, result = run_c_filter(cmd)

        show_output_popup(t, result.stdout, result.stderr)

        if result.returncode == 0:
            plot_output()

        if input_wav_path is not None:
            base = os.path.splitext(os.path.basename(input_wav_path))[0]
            out_wav = os.path.join(OUT_DIR, f"{base}_output.wav")
            pcm32_to_wav(OUTPUT_FILE, out_wav, current_fs)
            print(f"WAV generado: {out_wav}")

    # ================= PLOTS =================
    def plot_input():
        if not os.path.exists(input_pcm_path):
            return

        x = np.fromfile(input_pcm_path, dtype=np.int32) / (2**31 - 1)
        N = int(current_fs * 0.01)
        t = np.arange(N) / current_fs

        ax_in.clear()
        ax_in.plot(t, x[:N])
        ax_in.set_title("Señal de entrada")
        ax_in.set_xlabel("Tiempo [s]")
        ax_in.grid()
        canvas.draw()

    def plot_output():
        if not os.path.exists(OUTPUT_FILE):
            return

        y = np.fromfile(OUTPUT_FILE, dtype=np.int32) / (2**31 - 1)
        N = int(current_fs * 0.01)
        t = np.arange(N) / current_fs

        ax_out.clear()
        ax_out.plot(t, y[:N])
        ax_out.set_title("Señal de salida")
        ax_out.set_xlabel("Tiempo [s]")
        ax_out.grid()
        canvas.draw()

    def plot_coeffs():
        if not coef_file_path:
            return

        coeffs = np.loadtxt(coef_file_path)
        ax_coef.clear()
        ax_coef.stem(coeffs)
        ax_coef.set_title("Coeficientes FIR")
        ax_coef.set_box_aspect(1)
        ax_coef.grid()
        canvas.draw()

    def open_coef():
        nonlocal coef_file_path
        path = filedialog.askopenfilename(filetypes=[("TXT files", "*.txt")])
        if path:
            coef_file_path = path
            plot_coeffs()

    # ================= UI =================
    root = TkinterDnD.Tk()
    root.title("FIR Filter UTN")

    frame_main = tk.Frame(root)
    frame_main.pack()

    # CONFIG
    frame_config = tk.Frame(frame_main)
    frame_config.grid(row=0, column=0, padx=10, pady=10, sticky="n")

    tk.Label(frame_config, text="Configuración del filtro", font=("TkDefaultFont", 10, "bold")).pack()

    tk.Label(frame_config, text="Cantidad de bits fraccionales (max. 31)").pack()
    entry_nb_frac = tk.Entry(frame_config); entry_nb_frac.insert(0, "31"); entry_nb_frac.pack()

    tk.Label(frame_config, text="Cantidad de muestras (max. 256)").pack()
    entry_samples = tk.Entry(frame_config); entry_samples.insert(0, "80"); entry_samples.pack()

    # BOTONES
    frame_buttons = tk.Frame(frame_main)
    frame_buttons.grid(row=0, column=1, padx=10, pady=10, sticky="n")

    tk.Button(frame_buttons, text="Test Multitono", command=open_multitone_window).pack(fill="x")
    tk.Button(frame_buttons, text="Cargar archivo WAV", command=open_wav).pack(fill="x")
    tk.Button(frame_buttons, text="Seleccionar coeficientes", command=open_coef).pack(fill="x")
    tk.Button(frame_buttons, text="Ejecutar filtro", command=run_filter).pack(fill="x")

    # PLAYER
    frame_player = tk.Frame(frame_main)
    frame_player.grid(row=0, column=2, padx=10, pady=10, sticky="n")

    tk.Label(frame_player, text="Reproductor", font=("TkDefaultFont", 10, "bold")).pack()
    tk.Button(frame_player, text="▶ Reproducir entrada", command=play_input_audio).pack(fill="x")
    tk.Button(frame_player, text="▶ Reproducir salida", command=play_output_audio).pack(fill="x")

    label_input = tk.Label(root, text="Input: ninguno")
    label_input.pack()

    root.drop_target_register(DND_FILES)
    root.dnd_bind("<<Drop>>", drop)

    fig = Figure(figsize=(9, 4))
    gs = GridSpec(2, 2, width_ratios=[3, 1], figure=fig)

    ax_in = fig.add_subplot(gs[0, 0])
    ax_out = fig.add_subplot(gs[1, 0])
    ax_coef = fig.add_subplot(gs[:, 1])

    canvas = FigureCanvasTkAgg(fig, master=root)
    canvas.get_tk_widget().pack(fill="both", expand=True)

    root.mainloop()


def main():
    if "-gui" in sys.argv:
        run_gui()


if __name__ == "__main__":
    main()
